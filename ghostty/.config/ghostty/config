# =============================================================
# Ghostty config
# =============================================================

# Theme
theme = Catppuccin Mocha

# Font
font-family = JetBrainsMono Nerd Font
font-size = 13

# Window
window-padding-x = 8
window-padding-y = 8
background-opacity = 0.97

# Shell integration
shell-integration = zsh

# Behaviour
confirm-close-surface = false
mouse-hide-while-typing = true
copy-on-select = false
